{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    //
    // Build system: local edits are rsync'd to MY_IBM_I:~/projects/noxDbUtf8
    // (see .sitemule/rsync.sh) and built there via ssh + gmake. The remote
    // folder is fixed to "noxDbUtf8" (not the local, lower-case checkout
    // name) to match /home/NLI/projects/noxDbUtf8 on the IBM i.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile current file",
            "command": "${workspaceFolder}/.sitemule/compile_module.sh \"${workspaceRoot}\" \"noxDbUtf8\" \"${relativeFile}\" \"${fileBasenameNoExtension}\"",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": {
                "owner": "c",
                "fileLocation": [
                    "relative",
                    "${workspaceRoot}"
                ],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):(error|warning|info):(.{7}):(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "code": 5,
                    "message": 6
                }
            }
        },
        {
            "label": "Make all",
            "command": "${workspaceFolder}/.sitemule/gmake_remote.sh \"${workspaceRoot}\" \"noxDbUtf8\" \"all\"",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Create service program",
            "command": "${workspaceFolder}/.sitemule/gmake_remote.sh \"${workspaceRoot}\" \"noxDbUtf8\" \"noxDbUtf8.srvpgm\"",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "c",
                "fileLocation": [
                    "relative",
                    "${workspaceRoot}"
                ],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):(error|warning|info):(.{7}):(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "code": 5,
                    "message": 6
                }
            }
        },
        {
            "label": "Compile Test modules for noxDB",
            "command": "ssh MY_IBM_I 'PATH=/QOpenSys/pkgs/bin:$PATH;cd ~/projects/noxDbUtf8/test/;gmake'",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Compile current example/issue/test file",
            "command": "${workspaceFolder}/.sitemule/compile_current.sh \"${workspaceRoot}\" \"noxDbUtf8\" \"${relativeFile}\"",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "c",
                "fileLocation": [
                    "relative",
                    "${workspaceRoot}"
                ],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):(error|warning|info):(.{7}):(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "code": 5,
                    "message": 6
                }
            }
        },
        {
            "label": "Compile current unit test file",
            "command": "${workspaceFolder}/.sitemule/unittests.sh \"${workspaceRoot}\" \"noxDbUtf8\" \"${relativeFile}\" \"${fileBasename}\"",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "c",
                "fileLocation": [
                    "relative",
                    "${workspaceRoot}/unittests"
                ],
                "pattern": {
                    // FileName: *RNF7030 30    399 000022  The name or indicator A is not defined.
                    "regexp": "^\\./(.*):(\\d+),(\\d+),(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    // "severity": 4,
                    "message": 4
                }
            }
        },
        {
            "label": "Make release savefile",
            "command": "ssh MY_IBM_I 'PATH=/QOpenSys/pkgs/bin:$PATH;cd ~/projects/noxDbUtf8/;gmake release'",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Synchronize local to remote",
            "type": "shell",
            "command": "${workspaceFolder}/.sitemule/rsync.sh",
            "options": {
                "env": {
                    "FOLDER_BASE_NAME": "noxDbUtf8",
                    "FOLDER_ROOT": "${workspaceRoot}"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build all from local",
            "type": "shell",
            "command": "${workspaceFolder}/.sitemule/remote_run.sh ${workspaceFolder}/.sitemule/build_noxdb.sh",
            "options": {
                "env": {
                    "FOLDER_BASE_NAME": "noxDbUtf8",
                    "FOLDER_ROOT": "${workspaceRoot}"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "RPG",
                "fileLocation": [
                    "relative",
                    "${workspaceRoot}"
                ],
                "pattern": {
                    // FileName: *RNF7030 30    399 000022  The name or indicator A is not defined.
                    "regexp": "^\\./(.*):(\\d+),(\\d+),(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    // "severity": 4,
                    "message": 4
                }
            }
        }
    ]
}
